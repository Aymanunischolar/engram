# Required — cognee uses this same env var name for every LLM provider,
# not a provider-specific one like OPENAI_API_KEY. It's also reused
# automatically for embeddings below unless EMBEDDING_API_KEY is set.
LLM_API_KEY=

# --- Option A: OpenAI (cognee's own default) ---
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-5-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-large

# --- Option B: Gemini (cheaper) ---
# Embeddings are a *separate* config in cognee and default to OpenAI
# regardless of LLM_PROVIDER, so both must be set here or embedding
# calls will fail even with a valid Gemini key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-flash-latest
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Optional — defaults shown below are cognee 1.4.1's own defaults.
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=ladybug

# Required on Windows: ladybug/kuzu's JSON extension fails to load over
# its subprocess IPC on this platform ("The specified module could not
# be found") and crashes every pipeline run. Disabling the subprocess
# makes it a non-fatal warning instead - add/cognify/search/recall all
# confirmed working; only whichever specific operations actually need
# that JSON extension (not yet identified) would still fail. Confirmed
# necessary on Windows 10/11; probably safe to omit on Linux/macOS.
GRAPH_DATABASE_SUBPROCESS_ENABLED=false
